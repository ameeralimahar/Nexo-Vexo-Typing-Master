{
  "name": "nexovexo-typing-master",
  "version": "0.1.0",
  "private": true,
  "description": "NEXO VEXO Typing Master — exam-accurate typing practice portal",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "engine:test": "npm run test --workspace=@nexovexo/typing-engine",
    "engine:build": "npm run build --workspace=@nexovexo/typing-engine"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "npm@11.11.0"
}
